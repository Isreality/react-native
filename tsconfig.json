{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler" ,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "./*",
      ],
      "@assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
, "metro.config.js", "tailwind.config.js"  ],
  "exclude": [
    "node_modules"
  ]
}